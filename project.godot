; Engine configuration file.
; Dig Down / 地下鼠鼠 — Godot 4.7

config_version=5

[application]

config/name="Dig Down / 地下鼠鼠"
config/description="A finite free-digging systemic mouse-colony sandbox."
config/version="0.1.0-dev"
run/main_scene="res://scenes/app/game_app.tscn"

[autoload]

AppConfig="*res://src/infrastructure/config/app_config.gd"
GameLog="*res://src/infrastructure/logging/game_log.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
